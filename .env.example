# Server-side only. Never add a real token here to Git.
UPSTOX_ACCESS_TOKEN=

# Required for private API/WebSocket access. Use a long random value.
DASHBOARD_PASSWORD=

# Comma-separated exact origins, e.g. https://your-site.pages.dev
CORS_ORIGINS=http://localhost:5173

# Polling interval for REST snapshot mode (seconds; upstream rate limits apply).
SNAPSHOT_INTERVAL_SECONDS=15
